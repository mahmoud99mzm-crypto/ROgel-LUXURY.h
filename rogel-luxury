<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>متجر اكسسوارات تقليديه</title>
  <style>img{width:100%;height:220px;;object-fit:contain}</style>
  <style>
    body {
      background: #111;
      color: white;
      font-family: Arial, sans-serif;
      padding: 20px;
    }

    .product, .cart {
      border: 1px solid #d8b878;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 8px;
    }

    button {
      background: #d8b878;
      padding: 8px 12px;
      border: none;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <h1>متجر rogel luxury accessories</h1>

  <div class="product">
    <img src="c:\Users\Admin\OneDrive\Pictures\Screenshots\Screenshot 2026-10-08 215352.png">
    
    <h3>قلادة ذهبية</h3>
    <p>السعر:5دينار</p>
    <button onclick="addToCart(5)">
      أضف إلى السلة
    </button>
  </div>

  <div class="product">
    <img src="https://www.theinspirationedit.com/wp-content/uploads/2023/04/Womens-accessories-trends-for-this-Spring.jpg">
    <h3>حلق ذهبي</h3>
    <p>السعر:8دينار</p>
    <button onclick="addToCart(8)">
      أضف إلى السلة
    </button>
  </div>
  <div class="product">
    <img src="https://www.pngall.com/wp-content/uploads/5/Fashion-Women-Accessories-PNG.png">
    <h3>اسوره </h3>
    <p>السعر:3دينار</p>
    <button onclick="addToCart (3)">اضف الى السله</button>
    <div class="product">
        <img src="https://tse1.mm.bing.net/th/id/OIP.n2XV_QW6Pxv6cAQeG6xUewHaE3?r=0&rs=1&pid=ImgDetMain&o=7&rm=3">
        <h3> ساعه</h3>
        <p>السعر 4 دينار </p>
        <button onclick="addToCart(4)">اضف الى السله </button>
    </div>
    <div class="cart">
    <h2>سلة المشتريات</h2>

    <p>عدد المنتجات: <span id="count">0</span></p>
    <p>الإجمالي: <span id="total">0</span>دينار</p>

    <button type="button" onclick="orderCart()">
        اطلب عبر الواتساب
    </button>
</div>

<script>
let count = 0;
let total = 0;
let cartItems = [];

function addToCart(price) {
    const product = event.target.closest(".product");

    if (!product) {
        return;
    }

    const name = product.querySelector("h3").textContent;
    const description = product.querySelector("p").textContent;

    count++;
    total += price;

    cartItems.push({
        name: name,
        description: description,
        price: price
    });

    document.getElementById("count").textContent = count;
    document.getElementById("total").textContent = total;
}

function orderCart() {
    if (cartItems.length === 0) {
        alert("السلة فارغة! أضف منتجات أولاً.");
        return;
    }

    let message = "طلب جديد:\n\n";

    cartItems.forEach(function(item, index) {
        message += (index + 1) + "- " + item.name + "\n";
        message += item.description + "\n";
        message += "السعر: " + item.price + " دينار\n";
    });

    message += "عدد المنتجات: " + count + "\n";
    message += "الإجمالي: " + total + " دينار";

    const phone = "201152551977";
    const url = "https://wa.me/" + phone +
        "?text=" + encodeURIComponent(message);

    window.open(url, "_blank");
}
</script>
</body>
</html>
    


  

    
  
      
    
  

    


    

